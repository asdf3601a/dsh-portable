# Optional portable registry env for Sonatype Nexus (or any npm registry).
# Copy this file to data\registry.env and edit. dsh.cmd loads it only when that file exists.
# Lines starting with # are ignored. Do not put spaces around '='.
# Variables already set in the process environment are left unchanged (env wins).
#
# For //host/:_authToken= style auth, use data\npmrc instead (see npmrc.example).

# npm_config_registry=https://nexus.example.com/repository/npm-group/
# npm_config_always_auth=true
