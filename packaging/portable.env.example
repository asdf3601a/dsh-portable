# dsh-portable feature switches. Copy to data\portable.env (the build does this
# when the file is missing). No spaces around '='. Restart start.cmd / dsh.cmd
# after edits. Existing sessions keep the values they started with.

# Agent and launcher shell: pwsh (default, Windows PowerShell / pwsh) or bash
# (bundled Git Bash). Bundled git.exe is always preferred over a system Git.
# Parent DSH_SHELL=pwsh|bash overrides this file for one launch.
SHELL=pwsh

# Optional HTTP(S) proxy for Node (LLM, npm/pnpm via Node), git, and Git Bash
# curl. PROXY fills HTTP_PROXY and HTTPS_PROXY when those keys are omitted.
# Must be http:// or https://. NODE_USE_ENV_PROXY is turned on automatically.
# Loopback is bypassed unless you set NO_PROXY yourself.
# PROXY=http://proxy.example.com:8080
# HTTP_PROXY=http://proxy.example.com:8080
# HTTPS_PROXY=http://proxy.example.com:8080
# NO_PROXY=localhost,127.0.0.1,::1,.corp.example.com

# SOCKS for git and Git Bash curl only. Node and npm/pnpm do not honor SOCKS;
# point PROXY at an HTTP proxy if dsh itself must go through one.
# ALL_PROXY=socks5://127.0.0.1:1080

# Optional corporate MITM CA (PEM). Relative paths are from this folder root.
# NODE_EXTRA_CA_CERTS=data\certs\corp.pem

# Optional npm/pnpm registry (single registry; replaces copying data\npmrc).
# Parent npm_config_* env vars still win. Leave unset for registry.npmjs.org.
# NPM_REGISTRY=https://nexus.example.com/repository/npm-group/
# NPM_ALWAYS_AUTH=true
# NPM_AUTH_TOKEN=YOUR_TOKEN_HERE
